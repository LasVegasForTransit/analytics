{
  "name": "lvbt-analytics",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "lvbt bootstrap",
    "preflight": "lvbt preflight",
    "build": "turbo run build",
    "deploy": "pnpm check && pnpm --filter @lasvegasfortransit/analytics-collector exec wrangler deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:install": "pnpm --filter @lasvegasfortransit/analytics exec playwright install chromium",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "report": "tsx tools/report/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && markdownlint-cli2 && lvbt check && turbo run lint check-types test validate test:e2e --concurrency=1",
    "check:fix": "pnpm format && markdownlint-cli2 --fix && turbo run lint -- --fix",
    "prepare": "git config --local core.hooksPath .githooks 2>/dev/null || true"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@lvbt/cli": "github:LasVegasForTransit/repository-tooling#v0.2.7&path:/packages/cli",
    "@lvbt/prettier-config": "github:LasVegasForTransit/repository-tooling#v0.2.7&path:/packages/prettier-config",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-relative-links": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.20.0"
  }
}
